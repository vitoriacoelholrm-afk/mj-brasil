# MJ Brasil — environment template. Copy to `.env.local` (gitignored) and fill in.
# Scripts (db:migrate) + the server read these via scripts/_env.mjs; Vercel injects them as real env
# vars in CI/deploy. The DB-backed test suites (tenancy / request-path / installed-smoke) self-skip
# unless DATABASE_URL + DATABASE_URL_ADMIN are set.

# ── Database ────────────────────────────────────────────────────────────────────────────────────
# Two roles (the RLS spine): the runtime app role is NOBYPASSRLS (every query is tenant-scoped via
# withTenant); the admin role is the BYPASSRLS owner (migrations + the resolver's identity reads).
#
# Runtime app role (mj_brasil_app) — on Supabase, the transaction-mode pooler (port 6543, prepare:false):
DATABASE_URL=postgres://mj_brasil_app:CHANGE_ME@localhost:5432/postgres
# Admin/owner role — on Supabase, the session-mode pooler (5432); on plain Postgres, the `postgres` role:
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/postgres
# The password db:migrate sets on mj_brasil_app when it first creates the role (0000_roles.sql).
# Must match the password in DATABASE_URL above.
APP_DB_PASSWORD=CHANGE_ME
# Optional: app-role connection-pool size (default 10).
# DB_POOL_MAX=10

# ── Auth (Supabase JWT verification) ──────────────────────────────────────────────────────────────
# The server verifies bearer JWTs against the project's JWKS + issuer. Set SUPABASE_URL and the rest
# is derived; or override SUPABASE_JWKS_URL explicitly. Leave unset for local DB-only work — the auth
# tests self-skip and you can pin a membership in tests instead of minting a token.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Frontend (Vite — must be VITE_-prefixed to reach the browser) ─────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Local quickstart (docker postgres:17, no Supabase) ────────────────────────────────────────────
# docker run -d -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
# DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/postgres
# APP_DB_PASSWORD=app_pw   DATABASE_URL=postgres://mj_brasil_app:app_pw@localhost:5432/postgres
# pnpm db:migrate   # creates mj_brasil_app + applies every migration
# pnpm test         # the spine + installed-module suites run against it
