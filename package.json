{
  "name": "mj-brasil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20.11", "pnpm": ">=9" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:api": "node scripts/build-api.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p packages/db/tsconfig.json && tsc -p packages/trpc/tsconfig.json && tsc -p apps/web/tsconfig.check.json && node scripts/build-api.mjs && tsc -p api/tsconfig.json",
    "check:rls": "node scripts/check-rls.mjs",
    "check:procedures": "node scripts/check-procedures.mjs",
    "drift:check": "node .astralitics/drift-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "postgres": "^3.4.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  }
}
